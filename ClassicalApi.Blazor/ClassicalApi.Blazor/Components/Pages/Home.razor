@page "/"
@inject DialogService dialogService

<PageTitle>Eternal Classics</PageTitle>

<h1 class="invisible">Hello!</h1>

<div class="container-md" style="max-width:800px; margin-inline:auto">
    <RadzenStack Orientation="Orientation.Vertical" Gap="2rem" class="rz-p-3">
        <RadzenText TextStyle="TextStyle.H3" TextAlign="TextAlign.Center">
            Welcome to 'Classical Links'
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Justify" Style="font-size:larger; line-height: 1.7em;">
            Discover the timeless beauty of classical music with this simple web app,
            created especially for classical music fans. Explore information about renowned
            <a href="composers">composers</a> and find <a href="medialinks">links</a> to outstanding performances of their masterpieces.
        </RadzenText>

        <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Left">
            Why register?
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Justify" Style="font-size:larger; line-height: 1.7em;">
            By creating <a href="account\register">an account</a> (via email, Google, or Facebook), you unlock additional features: <br />
            <ul>
                <li>
                    Mark your favorite links with a "like" to save them to your personalized favorites list.
                </li>
                <li>
                    Easily revisit your favorite tracks anytime on your <a href="user">User</a> page.
                </li>
            </ul>
        </RadzenText>

        <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Left">
            Admin privileges
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Justify" Style="font-size:larger; line-height: 1.7em;">
            If you're granted admin access, you can contribute to our growing database by adding new information and links.
        </RadzenText>

        <RadzenText TextStyle="TextStyle.H5" TextAlign="TextAlign.Left">
            Get in touch!
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Justify" Style="font-size:larger; line-height: 1.7em;">
            Have questions or feedback? Feel free to contact the app developer via <a href="mailto:alextykoun@gmail.com">email</a>.
            If you love this project, consider supporting it with a <a href="https://www.paypal.com/donate/?hosted_button_id=MY596947WA9R2">virtual coffee</a> ☕!
        </RadzenText>

        <RadzenText TextStyle="TextStyle.Body1" TextAlign="TextAlign.Justify" Style="font-size:larger; line-height: 1.7em;">
            Enjoy the classics, and have a wonderful day!
        </RadzenText>
    </RadzenStack>
    <div class="d-flex justify-content-center my-3">
    </div>
</div>

