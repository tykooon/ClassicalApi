{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app-user.db",
    "MySqlConnection": "Server={SERVER};Port={PORT};User={USER};Password={PASSWORD};Database=classical_app_users;Connection Timeout={TIMEOUT}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5100"
      }
    }
  },
  "UseHttpsRequestScheme": true,
  "ForceSecureCookie": true,
  "LoggingHeaders": false

}
